{
  "name": "mallki-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "vite build",
    "db:migrate": "wrangler d1 migrations apply mallki-demo --local",
    "db:seed": "node --experimental-strip-types scripts/seed.mjs",
    "dev": "wrangler dev --ip 127.0.0.1",
    "test": "playwright test",
    "test:domain": "node --experimental-strip-types --test tests/database.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "5.1.1",
    "lucide-react": "0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "6.30.4"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "autoprefixer": "10.4.21",
    "esbuild": "0.27.7",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "8.0.0",
    "wrangler": "4.160.0"
  }
}
